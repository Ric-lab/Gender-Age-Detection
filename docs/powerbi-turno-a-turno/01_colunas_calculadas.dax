// ============================================================================
// COLUNAS CALCULADAS  |  tabela 'Hora a Hora'
// Botao: Modelagem -> Nova Coluna  (uma de cada vez)
// ============================================================================

// ----------------------------------------------------------------------------
// Turno  -> classifica cada periodo horario no turno correto.
// IMPORTANTE: usa TIMESTAMP_INICIO (hora de INICIO do periodo),
// NAO a coluna HORA (que e a hora de FIM). Foi essa troca que corrigiu o bug
// das horas de fronteira (05h, 13h, 21h) caindo no turno errado.
//   Turno 1 = 06:00 as 13:59
//   Turno 2 = 14:00 as 21:59
//   Turno 3 = 22:00 as 05:59  (vira a noite)
// ----------------------------------------------------------------------------
Turno =
VAR h = HOUR('Hora a Hora'[TIMESTAMP_INICIO])
RETURN
    SWITCH(
        TRUE(),
        h >= 6  && h < 14, 1,
        h >= 14 && h < 22, 2,
        3
    )


// ----------------------------------------------------------------------------
// Data_Turno  -> a que "dia de turno" cada linha pertence.
// A madrugada (00h-05h) e jogada para o DIA ANTERIOR, porque pertence ao
// turno que comecou na noite anterior. Assim o Turno 3 de um dia = 22h-00h
// desse dia + 00h-06h do dia seguinte, todos com o mesmo Data_Turno.
// ----------------------------------------------------------------------------
Data_Turno =
VAR h        = HOUR('Hora a Hora'[TIMESTAMP_INICIO])
VAR data_ref = DATE(
    YEAR('Hora a Hora'[TIMESTAMP_INICIO]),
    MONTH('Hora a Hora'[TIMESTAMP_INICIO]),
    DAY('Hora a Hora'[TIMESTAMP_INICIO])
)
RETURN
    IF(h < 6, data_ref - 1, data_ref)
